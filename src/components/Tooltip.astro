---
/** [data-tip] を持つ要素に共通のツールチップを出す（ページに1つ置く） */
---

<div id="tip" role="tooltip" hidden></div>

<style is:global>
  #tip {
    position: fixed;
    z-index: 50;
    max-width: 260px;
    padding: 6px 10px;
    border-radius: 6px;
    background: var(--text);
    color: var(--bg);
    font-size: 0.8rem;
    line-height: 1.5;
    pointer-events: none;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
  }
</style>

<script>
  const tip = document.getElementById("tip")!;
  const show = (el: HTMLElement, x: number, y: number) => {
    tip.textContent = el.dataset.tip ?? "";
    tip.hidden = false;
    const w = tip.offsetWidth;
    const h = tip.offsetHeight;
    tip.style.left = `${Math.min(Math.max(8, x - w / 2), innerWidth - w - 8)}px`;
    tip.style.top = `${y - h - 12 < 8 ? y + 16 : y - h - 12}px`;
  };
  const target = (e: Event) => (e.target as HTMLElement).closest?.("[data-tip]") as HTMLElement | null;
  document.addEventListener("pointermove", (e) => {
    const el = target(e);
    if (el) show(el, e.clientX, e.clientY);
    else tip.hidden = true;
  });
  document.addEventListener("focusin", (e) => {
    const el = target(e);
    if (!el) return;
    const r = el.getBoundingClientRect();
    show(el, r.left + r.width / 2, r.top);
  });
  document.addEventListener("focusout", () => (tip.hidden = true));
  addEventListener("scroll", () => (tip.hidden = true), { passive: true });
</script>
